APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# System admin email shown to banned patrons on the login popup (default: info@fprdi.dost.gov.ph)
# ADMIN_EMAIL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel9
DB_USERNAME=root
DB_PASSWORD=
# Password `php artisan db:seed` gives the seeded accounts (blank = a random one, printed once)
# SEED_USER_PASSWORD=

DB_CONNECTION=mysql
DB_HOST_OLDSLIM=
DB_PORT_OLDSLIM=
DB_DATABASE_OLDSLIM=
DB_USERNAME_OLDSLIM=
DB_PASSWORD_OLDSLIM=


BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"


# --- Meilisearch (Scout) ---
# Flip SCOUT_DRIVER to 'meilisearch' AFTER the container is up and the index imported.
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_KEY=
# Consumed by docker-compose.yml (kept here so it stays out of git):
MEILI_MASTER_KEY=

# Hermes agent gateway (OPAC "AI mode") — see .env.example
HERMES_GATEWAY_URL=http://127.0.0.1:8090
HERMES_GATEWAY_TOKEN=
HERMES_GATEWAY_TIMEOUT=60

# New passwords are checked against Have I Been Pwned (only the first 5 characters of the
# password's SHA-1 hash are sent). Set to false on a server with no internet access.
PASSWORD_BREACH_CHECK=true
