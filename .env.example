# Copy to .env, then: php artisan key:generate
# Values for local, staging and production: docs/implemented/DEPLOYMENT_CHECKLIST.md, Part D1.
APP_NAME=eLibrary
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Email shown to banned patrons on the sign-in popup. Set it: the built-in default
# (info@fprdi.dost.gov.ph) is another institute's address.
# ADMIN_EMAIL=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=elibrarydb
DB_USERNAME=root
DB_PASSWORD=
# Password `php artisan migrate --seed` gives the three sample accounts (blank = a random one,
# printed once). Remove it from .env after seeding.
# SEED_USER_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
# sync: nothing is queued, so no queue worker is needed (Scout indexes as records are saved).
QUEUE_CONNECTION=sync
# database: the profile pages' "Where you're signed in" list needs it. Switching from file signs everyone out once.
SESSION_DRIVER=database
# Minutes an unused session is kept. Keep it above the longest idle limit (2 hours, config/session.php
# "limits"), or the sign-in page can't say why a patron was signed out.
SESSION_LIFETIME=180
# The session cookie is Secure and named __Host-... unless this is false. Leave it true (the default)
# everywhere except local development on plain http:// with a host name other than localhost
# (Laragon's http://elibrary.test): there, false, or sign-in fails.
SESSION_SECURE_COOKIE=true

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# log: mail is written to storage/logs/laravel.log instead of being sent (local development).
# Staging and production: smtp, with the host, port, encryption, account and sender below.
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.org"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Meilisearch (Scout): the OPAC search. docs/implemented/MEILISEARCH_SETUP.md ---
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://127.0.0.1:7700
# The master key (16 characters or more), the same value as MEILI_MASTER_KEY.
MEILISEARCH_KEY=
# Read by docker-compose.yml and meili.sh to start Meilisearch (kept here so it stays out of git):
MEILI_MASTER_KEY=
# development locally; production on staging and production servers (no search preview page).
MEILI_ENV=development

# Hermes agent gateway (OPAC "AI mode"; optional, off until switched on in Admin → Settings):
# DEPLOYMENT_CHECKLIST.md, Part D9.
HERMES_GATEWAY_URL=http://127.0.0.1:8090
HERMES_GATEWAY_TOKEN=
HERMES_GATEWAY_TIMEOUT=60

# "I'm human" check on the sign-up form (Cloudflare Turnstile). Empty = off. Local and staging: Cloudflare's
# test keys below (always pass; 2x00000000000000000000AB / 2x0000000000000000000000000000000AA always fail).
# Production: the agency's own widget (Cloudflare dashboard → Turnstile). DEPLOYMENT_CHECKLIST.md, Part D10.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# "Continue with Google" for patrons. Empty = off. An OAuth client of the agency's Google Cloud project:
# one for local and staging, another for production. DEPLOYMENT_CHECKLIST.md, Part D10.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Empty: this site's own address + /auth/google/callback. Whichever it is, the OAuth client must list it exactly.
GOOGLE_REDIRECT_URI=

# New passwords are checked against Have I Been Pwned (only the first 5 characters of the
# password's SHA-1 hash are sent). Set to false on a server with no internet access.
PASSWORD_BREACH_CHECK=true

# HTTPS only (HSTS): browsers keep to HTTPS for a year after an HTTPS visit. Sent on HTTPS only.
# 0 makes browsers forget it, if the site ever has to go back to plain HTTP.
HSTS_MAX_AGE=31536000

# Content Security Policy: enforced (only this site's scripts, jsDelivr and nonce-tagged inline scripts).
# false is the emergency switch: the policy then only reports. docs/implemented/CSP_ROLLOUT.md
CSP_ENFORCE=true
